# EmailJS credentials for the EnrollNow and Contact forms.
# Copy this file to .env.local and fill in real values from your EmailJS dashboard
# (https://dashboard.emailjs.com/). .env.local is gitignored and must never be committed.
VITE_EMAILJS_SERVICE_ID=
# Used by EnrollNow (fields: guardian_name, student_name, from_email, contact_number, student_type, program_interest, message, to_email)
VITE_EMAILJS_TEMPLATE_ID=
# Used by Contact (fields: from_name, from_email, message, to_email)
VITE_EMAILJS_CONTACT_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
